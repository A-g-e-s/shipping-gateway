{
    "name": "ages/shipping-gateway",
    "description": "Unified shipping carrier API for CzechPost, GLS, PPL",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "guzzlehttp/guzzle": "^7.9",
        "nette/utils": "^4.0",
        "mpdf/mpdf": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ages\\ShippingGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ages\\ShippingGateway\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    }
}
